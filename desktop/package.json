{
  "name": "v-run",
  "version": "0.1.0",
  "private": true,
  "description": "V-Run — the FreeToken desktop coding app (Electron editor + agent)",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "start": "electron .",
    "test": "tsx test/core.test.ts",
    "e2e": "tsx test/e2e.ts",
    "test:all": "tsx test/core.test.ts && tsx test/freetoken.test.ts && tsx test/freetoken-link.test.ts",
    "e2e:ft": "tsx test/e2e-freetoken.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@vscode/ripgrep": "^1.18.0",
    "openai": "^7.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
