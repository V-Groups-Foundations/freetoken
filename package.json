{
  "name": "free_token",
  "version": "0.1.0",
  "private": true,
  "description": "FreeToken by V Groups: pool every free AI API tier (Gemini, Groq, OpenRouter, NVIDIA, Cohere, GitHub Models) into one chat, one OpenAI-compatible API and V-Run, a desktop AI coding agent. Free, self-hosted.",
  "keywords": [
    "free-ai",
    "free-tokens",
    "free-llm-api",
    "openai-compatible",
    "llm-router",
    "ai-gateway",
    "gemini",
    "groq",
    "openrouter",
    "ai-coding-agent",
    "cursor-alternative",
    "claude-code-alternative",
    "self-hosted",
    "v-groups"
  ],
  "license": "MIT",
  "homepage": "https://github.com/V-Groups-Foundations/freetoken#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/V-Groups-Foundations/freetoken.git"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "cli": "node bin/freetoken.mjs",
    "desktop": "node scripts/desktop.mjs",
    "dev:all": "node scripts/desktop.mjs --with-server",
    "test:desktop": "npm --prefix desktop run test:all"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "bin": {
    "freetoken": "bin/freetoken.mjs"
  }
}
